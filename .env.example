# Firebase Configuration
# Option 1: Full service account JSON (raw JSON string or base64 encoded)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
# Option 2: Individual service account fields (alternative to FIREBASE_SERVICE_ACCOUNT_KEY)
FIREBASE_PROJECT_ID=valentino-ice-cream
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# Encryption (Must be 32 characters)
PAYMENT_ENCRYPTION_KEY=your_secret_encryption_key_32_chars

# AI Services
