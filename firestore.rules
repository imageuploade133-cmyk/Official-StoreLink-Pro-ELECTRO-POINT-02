rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Core Authentication Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Get current user's staff record to find their assigned store identifier
    function getStaffStoreId(data) {
      return data != null ? (data.get('store_id', data.get('storeId', null))) : null;
    }

    // Check if the user is the owner of a specific store
    function isStoreOwner(storeId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/stores/$(storeId)) && 
         get(/databases/$(database)/documents/stores/$(storeId)).data.owner_id == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/stores/$(storeId)) && 
         getAfter(/databases/$(database)/documents/stores/$(storeId)).data.owner_id == request.auth.uid)
      );
    }

    // Check if the user is a staff member of a specific store
    function isStoreStaff(storeId) {
      return isSignedIn() && (
        // Check for combined ID format (new system: uid_storeId)
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid + "_" + storeId)) && 
         getStaffStoreId(get(/databases/$(database)/documents/staff/$(request.auth.uid + "_" + storeId)).data) == storeId) ||
        (existsAfter(/databases/$(database)/documents/staff/$(request.auth.uid + "_" + storeId)) && 
         getStaffStoreId(getAfter(/databases/$(database)/documents/staff/$(request.auth.uid + "_" + storeId)).data) == storeId) ||
        // Check for UID-only ID format (old system: uid)
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         getStaffStoreId(get(/databases/$(database)/documents/staff/$(request.auth.uid)).data) == storeId) ||
        (existsAfter(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         getStaffStoreId(getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data) == storeId)
      );
    }

    // Determine if the user has administrative/managerial access to the store
    function canManageStore(storeId) {
      return storeId != null && (isStoreOwner(storeId) || isStoreStaff(storeId));
    }

    // Helper to check store identity in resource or request.resource
    function hasStoreAccess() {
      return canManageStore(getStaffStoreId(request.method == 'create' ? request.resource.data : resource.data));
    }

    // Helper for subcollection access
    function canAccessSubcollection(collectionName, docId) {
      return isSignedIn() && (
        (collectionName == 'stores' && canManageStore(docId)) ||
        (collectionName != 'stores' && (
          existsAfter(/databases/$(database)/documents/$(collectionName)/$(docId)) ? (
            canManageStore(getStaffStoreId(getAfter(/databases/$(database)/documents/$(collectionName)/$(docId)).data)) ||
            getAfter(/databases/$(database)/documents/$(collectionName)/$(docId)).data.get('uid', null) == request.auth.uid ||
            getAfter(/databases/$(database)/documents/$(collectionName)/$(docId)).data.get('owner_id', null) == request.auth.uid
          ) : (
            exists(/databases/$(database)/documents/$(collectionName)/$(docId)) && (
              canManageStore(getStaffStoreId(get(/databases/$(database)/documents/$(collectionName)/$(docId)).data)) ||
              get(/databases/$(database)/documents/$(collectionName)/$(docId)).data.get('uid', null) == request.auth.uid ||
              get(/databases/$(database)/documents/$(collectionName)/$(docId)).data.get('owner_id', null) == request.auth.uid
            )
          )
        ))
      );
    }

    /* ============================================================
       1. PUBLIC COLLECTIONS (Public Read, Protected Write)
       ============================================================ */

    match /products/{docId=**} {
      allow read: if true;
      allow write: if isSignedIn() && hasStoreAccess();
    }

    match /categories/{docId=**} {
      allow read: if true;
      allow write: if isSignedIn() && hasStoreAccess();
    }

    match /publicPages/{docId=**} {
      allow read: if true;
      allow write: if isSignedIn() && hasStoreAccess();
    }

    match /slideShows/{docId=**} {
      allow read: if true;
      allow write: if isSignedIn() && hasStoreAccess();
    }

    match /homepageSections/{docId=**} {
      allow read: if true;
      allow write: if isSignedIn() && hasStoreAccess();
    }

    match /sync_settings/{docId=**} {
      allow read, write: if false;
    }

    match /product_sync_map/{docId=**} {
      allow read, write: if false;
    }

    match /integration_events/{docId=**} {
      allow read, write: if false;
    }

    match /processed_sync_events/{docId=**} {
      allow read, write: if false;
    }

    match /payment_providers/{docId=**} {
      allow read, write: if false;
    }

    match /adLinks/{docId=**} {
      allow read: if true;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'views'])) || (isSignedIn() && hasStoreAccess());
      allow create, delete: if isSignedIn() && hasStoreAccess();
    }

    match /coupons/{docId=**} {
      allow read: if true;
      allow write: if isSignedIn() && hasStoreAccess();
    }

    match /analytics/{docId=**} {
      allow read, write: if true;
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && canManageStore(getStaffStoreId(resource.data));
    }

    /* Store reviews collection for dashboard management */
    match /store_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && canManageStore(getStaffStoreId(resource.data));
    }

    match /settings/{storeId} {
      allow read: if true; 
      allow write: if isSignedIn() && (storeId == 'global' || canManageStore(storeId) || storeId == request.auth.uid);
    }

    /* ============================================================
       2. USER & STORE MANAGEMENT
       ============================================================ */

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /customerAuth/{authId} {
      // customerAuth should only be accessible by the Admin API
      allow read, write: if false;
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && isStoreOwner(storeId);
      
      match /analytics/{docId} {
        allow read, write: if true;
      }

      // Allow access to settings subcollection
      match /settings/{docId} {
        allow read: if true;
        allow write: if isSignedIn() && canManageStore(storeId);
      }
    }

    match /staff/{staffId} {
      allow read: if isSignedIn() && (
        request.auth.uid == staffId || 
        // Also support combined ID format for read
        staffId.startsWith(request.auth.uid + "_") ||
        (resource != null && canManageStore(getStaffStoreId(resource.data)))
      );
      allow write: if isSignedIn() && (
        // Allow creating own staff record during signup
        (request.method == 'create' && (
          request.resource.data.get('uid', null) == request.auth.uid || 
          canManageStore(getStaffStoreId(request.resource.data))
        )) ||
        // Allow update/delete if self or manager
        (request.method != 'create' && (
          (resource != null && resource.data.get('uid', null) == request.auth.uid) || 
          canManageStore(getStaffStoreId(resource.data))
        ))
      );
    }

    match /customers/{customerId} {
      allow read: if isSignedIn() && (
        request.auth.uid == customerId || 
        (resource != null && canManageStore(getStaffStoreId(resource.data)))
      );
      allow write: if isSignedIn() && (
        request.auth.uid == customerId || 
        (request.method == 'create' && (request.auth.uid == customerId || canManageStore(getStaffStoreId(request.resource.data)))) ||
        (request.method != 'create' && (resource != null && canManageStore(getStaffStoreId(resource.data))))
      );
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == customerId ||
          (exists(/databases/$(database)/documents/customers/$(customerId)) && canManageStore(getStaffStoreId(get(/databases/$(database)/documents/customers/$(customerId)).data)))
        );
      }
    }

    /* ============================================================
       3. PRIVATE BUSINESS DATA (Strictly Isolated by Store)
       ============================================================ */
    
    match /{collectionName}/{docId} {
      allow read: if isSignedIn() && (
        (resource != null && (resource.data.get('store_id', null) != null || resource.data.get('storeId', null) != null) && canManageStore(getStaffStoreId(resource.data))) ||
        (resource != null && resource.data.get('uid', null) == request.auth.uid) ||
        (resource != null && resource.data.get('customerId', null) == request.auth.uid) ||
        (resource != null && resource.data.get('user_id', null) == request.auth.uid) ||
        (collectionName == 'analytics')
      );
      
      allow write: if isSignedIn() && (
        (request.method == 'create' && (
          (request.resource.data.get('store_id', null) != null || request.resource.data.get('storeId', null) != null) && canManageStore(getStaffStoreId(request.resource.data)) ||
          (request.resource.data.get('uid', null) == request.auth.uid) || 
          (collectionName == 'customers' && docId == request.auth.uid) ||
          (collectionName == 'orders') ||
          (collectionName == 'analytics')
        )) ||
        (request.method != 'create' && (
          (resource != null && (resource.data.get('store_id', null) != null || resource.data.get('storeId', null) != null) && canManageStore(getStaffStoreId(resource.data))) ||
          (resource != null && resource.data.get('uid', null) == request.auth.uid)
        ))
      );

      // Recursive match for subcollections
      match /{allSubcollections=**} {
         allow read, write: if canAccessSubcollection(collectionName, docId);
      }
    }

  }
}
