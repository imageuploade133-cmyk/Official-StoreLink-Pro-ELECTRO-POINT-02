
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.role == "admin" || exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == "admin");
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getStaffRole() {
        return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }
    
    function isStaffWithOneOfRoles(roles) {
        return exists(/databases/$(database)/documents/staff/$(request.auth.uid)) 
               && getStaffRole() in roles;
    }

    // Rules for collections that are publicly readable
    match /products/{doc} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /categories/{doc} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();
    }
    
    match /publicPages/{pageId} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /slideShows/{slideId} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }
    
    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }
    
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin() || isStaffWithOneOfRoles(['admin']);
    }
    
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /staff/{userId} {
      allow get: if isOwner(userId) || isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      allow list: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      allow write: if isAdmin() || isStaffWithOneOfRoles(['admin']);
    }
    
    match /branches/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isStaffWithOneOfRoles(['admin']);
    }
    
    match /saleTransactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      allow delete: if isAdmin() || isStaffWithOneOfRoles(['admin']);
    }

    match /customers/{doc} {
      allow read, write: if isSignedIn();
    }
    
    match /restockEntries/{doc} {
      allow read: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();
      allow create: if isSignedIn();
    }

    match /heldSales/{saleId} {
      allow read, write: if isSignedIn();
    }

    match /creditPayments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /customerHistory/{doc} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
    
    match /expenses/{expenseId} {
      allow read, create: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      allow update, delete: if isAdmin() || isStaffWithOneOfRoles(['admin']);
    }

    match /reversals/{reversalId} {
      allow read, create: if isAdmin() || isStaffWithOneOfRoles(['admin']);
      allow update, delete: if false;
    }
    
    match /stockTransfers/{transferId} {
        allow read, write: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();
    }

    match /whatsappMessageLogs/{logId} {
        allow read, write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /adLinks/{adId} {
        allow read: if true;
        allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    // 1. Payment Providers (Admin Only)
    match /payment_providers/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Transactions (Backend Only)
    match /transactions/{doc} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.user_id);
      // Only backend (server) should write transactions
      allow write: if false;
    }

    // 3. Orders
    match /orders/{doc} {
      // User can read their own orders, Admin can read all
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.user_id);
      // User can create order
      allow create: if isSignedIn();
      // Only backend/admin can update order status (paid, failed)
      allow update: if isAdmin();
      // No delete
      allow delete: if false;
    }

    match /coupons/{doc} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /flash_sales/{doc} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /invoices/{doc} {
      allow read, write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /websiteTraffic/{doc} {
      allow read: if true;
      allow write: if false; // Should be handled by backend
    }

    match /stockAuditEntries/{doc} {
      allow read: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      allow write: if false; // Should be handled by backend
    }
    
    /* =====================================================================
       FALLBACK SECURITY LOCK
    ===================================================================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
