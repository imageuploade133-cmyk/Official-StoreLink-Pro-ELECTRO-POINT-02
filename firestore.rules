
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == "admin" || 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isStaffWithOneOfRoles(roles) {
        return exists(/databases/$(database)/documents/staff/$(request.auth.uid)) 
               && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in roles;
    }

    // --- ENFORCE STORE ISOLATION (Point 1) ---
    // General check that can be used across collections
    function hasStoreAccess(roles) {
      let storeId = (resource == null ? request.resource.data.store_id : resource.data.store_id);

      return isSignedIn() && (
        // Owner of the store
        storeId == request.auth.uid ||

        // Staff belongs to store
        (
          isStaffWithOneOfRoles(roles) &&
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.store_id == storeId
        )
      );
    }

    // Point 5: PRODUCTS SHOULD BE STORE-BASED
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin()
        && request.auth.uid == (resource == null ? request.resource.data.store_id : resource.data.store_id);

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Point 2: FIX CUSTOMERS COLLECTION
    match /customers/{doc} {
      allow read, write: if isSignedIn()
        && request.auth.uid == (resource == null ? request.resource.data.store_id : resource.data.store_id);
    }

    // Point 3: SECURE ORDERS CREATION
    match /orders/{doc} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.user_id
        && request.resource.data.amount > 0
        && request.resource.data.store_id != null;

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.user_id);

      allow update: if isAdmin();

      allow delete: if false;
    }

    // Point 4: VALIDATE TRANSACTIONS STRUCTURE
    match /transactions/{doc} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.user_id);
      allow write: if false;
    }

    // --- OTHER COLLECTIONS APPLYING POINT 1 ---

    match /categories/{doc} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin', 'manager', 'inventory_manager']);
    }
    
    match /publicPages/{pageId} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin', 'manager']);
    }

    match /slideShows/{slideId} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin', 'manager']);
    }
    
    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin', 'manager']);
    }
    
    match /settings/{doc} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin']);
    }
    
    match /users/{userId} {
      allow read, write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }
    
    match /staff/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || hasStoreAccess(['admin', 'manager']) || isAdmin();
      allow list: if hasStoreAccess(['admin', 'manager']) || isAdmin();
      allow write: if isAdmin() || hasStoreAccess(['admin']);
    }
    
    match /branches/{doc} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.store_id;
      allow write: if hasStoreAccess(['admin']);
    }
    
    match /saleTransactions/{transactionId} {
      allow get, list: if isSignedIn() && request.auth.uid == resource.data.store_id;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.store_id;
      allow update: if hasStoreAccess(['admin', 'manager']);
      allow delete: if hasStoreAccess(['admin']);
    }
    
    match /restockEntries/{doc} {
      allow read: if hasStoreAccess(['admin', 'manager', 'inventory_manager']);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.store_id;
    }

    match /heldSales/{saleId} {
      allow read, write: if isSignedIn() && request.auth.uid == (resource == null ? request.resource.data.store_id : resource.data.store_id);
    }

    match /creditPayments/{paymentId} {
      allow get, list: if isSignedIn() && request.auth.uid == resource.data.store_id;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.store_id;
      allow write: if hasStoreAccess(['admin', 'manager']);
    }

    match /customerHistory/{doc} {
      allow read, create: if isSignedIn() && request.auth.uid == (resource == null ? request.resource.data.store_id : resource.data.store_id);
      allow update, delete: if false;
    }
    
    match /expenses/{expenseId} {
      allow read, create: if hasStoreAccess(['admin', 'manager']);
      allow update, delete: if hasStoreAccess(['admin']);
    }

    match /reversals/{reversalId} {
      allow read, create: if hasStoreAccess(['admin']);
      allow update, delete: if false;
    }
    
    match /stockTransfers/{transferId} {
        allow read, write: if hasStoreAccess(['admin', 'manager', 'inventory_manager']);
    }

    match /whatsappMessageLogs/{logId} {
        allow read, write: if hasStoreAccess(['admin', 'manager']);
    }

    match /adLinks/{adId} {
        allow read: if true;
        allow write: if hasStoreAccess(['admin', 'manager']);
    }

    match /payment_providers/{doc} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.store_id;
      allow write: if isAdmin() && request.auth.uid == (resource == null ? request.resource.data.store_id : resource.data.store_id);
    }

    match /coupons/{doc} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin', 'manager']);
    }

    match /flash_sales/{doc} {
      allow read: if true;
      allow write: if hasStoreAccess(['admin', 'manager']);
    }

    match /invoices/{doc} {
      allow read, write: if hasStoreAccess(['admin', 'manager']);
    }

    match /websiteTraffic/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /stockAuditEntries/{doc} {
      allow read: if hasStoreAccess(['admin', 'manager']);
      allow write: if false;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
