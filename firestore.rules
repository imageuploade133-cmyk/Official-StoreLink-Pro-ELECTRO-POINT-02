
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // A "Firebase only" user (admin) is one who is authenticated but has no staff document.
      return request.auth != null && !exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function getStaffRole() {
        // Return the role of the user from the /staff collection.
        // This function should only be called within a context where the user has read access to their own staff document.
        return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }
    
    // Checks if the user is a staff member with one of the provided roles.
    function isStaffWithOneOfRoles(roles) {
        return exists(/databases/$(database)/documents/staff/$(request.auth.uid)) 
               && getStaffRole() in roles;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for collections that are publicly readable
    match /products/{doc} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();
    }

    match /categories/{doc} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();
    }
    
    match /publicPages/{pageId} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /slideShows/{slideId} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }
    
    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }
    
    // Rules for settings - only super admin
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Rules for user-specific data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Rules for staff and branch management - admin heavy
    match /staff/{userId} {
      // A user can GET their own document (to check their role for UI permissions).
      // An admin/manager can GET any staff document.
      allow get: if isOwner(userId) || isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      
      // Only admins/managers can LIST the entire staff collection.
      allow list: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();

      // Only the super-admin can create, update, or delete staff profiles.
      allow write: if isAdmin();
    }
    
    match /branches/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Rules for transactions and financial records
    match /saleTransactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn(); // Any staff can create a sale via POS
      allow update: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin(); // Only managers/admins can process returns
      allow delete: if isAdmin(); // Only super-admin can delete sales records
    }

    match /customers/{doc} {
      allow read, write: if isSignedIn(); // Any staff can create/edit customers
    }
    
    match /restockEntries/{doc} {
      allow read: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']);
      allow create: if isSignedIn();
    }

    match /heldSales/{saleId} {
      allow read, write: if isSignedIn(); // POS feature for any staff
    }

    match /creditPayments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /customerHistory/{doc} {
      allow read, create: if isSignedIn();
      allow update, delete: if false; // History is immutable
    }
    
    match /expenses/{expenseId} {
      allow read, create: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /reversals/{reversalId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    
    match /stockTransfers/{transferId} {
        allow read, write: if isStaffWithOneOfRoles(['admin', 'manager', 'inventory_manager']) || isAdmin();
    }

    match /whatsappMessageLogs/{logId} {
        allow read, write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }

    match /adLinks/{adId} {
        allow read: if true;
        allow write: if isStaffWithOneOfRoles(['admin', 'manager']) || isAdmin();
    }
    
    /* =====================================================================
       FALLBACK SECURITY LOCK
    ===================================================================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
