rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /* ===============================
       PUBLIC READ COLLECTIONS
    =============================== */

    match /products/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publicPages/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /slideShows/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /homepageSections/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /payment_providers/{document=**} {
      allow read, write: if false;
    }

    /* Reviews subcollection - allow authenticated users to create */
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /* Store reviews collection for dashboard management */
    match /store_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    /* ✅ ADD THIS */
    match /settings/{document=**} {
      allow read: if true;          // public can read settings/global
      allow write: if isSignedIn(); // only logged-in users can modify
    }

    match /stores/{storeId}/settings/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /* ===============================
       AUTH REQUIRED COLLECTIONS
    =============================== */

    match /{document=**} {
      allow read, write: if isSignedIn();
    }

  }
}
