rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /* ===============================
       PUBLIC READ COLLECTIONS
    =============================== */

    match /products/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publicPages/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /slideShows/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /homepageSections/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /* ✅ ADD THIS */
    match /settings/{document=**} {
      allow read: if true;          // public can read settings/global
      allow write: if isSignedIn(); // only logged-in users can modify
    }

    match /stores/{storeId}/settings/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /* ===============================
       AUTH REQUIRED COLLECTIONS
    =============================== */

    match /{document=**} {
      allow read, write: if isSignedIn();
    }

  }
}
