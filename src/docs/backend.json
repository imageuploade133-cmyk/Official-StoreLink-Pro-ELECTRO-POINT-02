
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "deliveryAddress": {
          "type": "string",
          "description": "The user's primary delivery address."
        },
        "alternativePhoneNumber": {
          "type": "string",
          "description": "An alternative phone number for delivery purposes."
        }
      },
      "required": [
        "uid",
        "email"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Represents a product in the store.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the product."
        },
        "sellingPrice": {
          "type": "number",
          "description": "The selling price of the product."
        },
        "purchasePrice": {
          "type": "number",
          "description": "The cost of the product."
        },
        "stock": {
          "type": "number",
          "description": "Current stock quantity."
        },
        "categoryId": {
          "type": "string",
          "description": "The ID of the category this product belongs to."
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit."
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "The stock level at which to trigger a low stock alert."
        },
        "isVisibleInPOS": {
          "type": "boolean",
          "description": "Whether the product is visible in the Point of Sale interface."
        },
        "barcode": {
          "type": "string",
          "description": "The product's barcode."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the product."
        },
        "expiryDate": {
          "type": "string",
          "format": "date-time",
          "description": "The product's expiration date."
        },
        "supplierName": {
          "type": "string",
          "description": "Name of the product's supplier."
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the product's image."
        },
        "dataAiHint": {
            "type": "string",
            "description": "A hint for AI image generation services."
        },
        "promo": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["percentage", "fixed"] },
              "value": { "type": "number" },
              "startDate": { "type": "string", "format": "date-time" },
              "endDate": { "type": "string", "format": "date-time" },
              "isActive": { "type": "boolean" }
            },
            "description": "Promotional pricing for the product."
        },
        "allowPriceModification": {
          "type": "boolean",
          "description": "Whether the price can be modified at the point of sale."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the product was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the product was last updated."
        },
        "barcodeGenerated": {
          "type": "boolean",
          "description": "Whether the barcode was auto-generated by the system."
        }
      },
      "required": [
        "name",
        "sellingPrice",
        "purchasePrice",
        "stock",
        "categoryId",
        "isVisibleInPOS"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Represents a product category.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the category."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the category."
        },
        "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the category's image."
        },
        "dataAiHint": {
            "type": "string",
            "description": "A hint for AI image generation services."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the category was created."
        }
      },
      "required": [
        "name"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a customer order.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who placed the order."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "price": {
                "type": "number"
              }
            },
            "required": [
              "productId",
              "quantity",
              "price"
            ]
          }
        },
        "totalAmount": {
          "type": "number",
          "description": "The total amount of the order."
        },
        "totalCost": {
          "type": "number",
          "description": "The total cost of goods for the order."
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "credit_card",
            "paypal",
            "other"
          ],
          "description": "The payment method used."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the order was placed."
        }
      },
      "required": [
        "userId",
        "items",
        "totalAmount",
        "totalCost",
        "paymentMethod"
      ]
    },
    "Settings": {
      "title": "Global Settings",
      "description": "Stores global application settings.",
      "type": "object",
      "properties": {
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "currency": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "colorPrimary": { "type": "string" },
        "colorBackground": { "type": "string" },
        "colorDestructive": { "type": "string" },
        "colorSuccess": { "type": "string" },
        "backgroundStyle": { "type": "string", "enum": ["solid", "gradient", "image", "video"] },
        "backgroundImageUrl": { "type": "string", "format": "uri" },
        "backgroundGradientStart": { "type": "string" },
        "backgroundGradientEnd": { "type": "string" },
        "backgroundVideoUrl": {
          "type": "string", 
          "format": "uri",
          "description": "URL of the background video for the public website."
        },
        "backgroundVideoImageUrl": {
          "type": "string", 
          "format": "uri",
          "description": "URL of a poster image for the background video."
        },
        "preventManualStockReduction": { "type": "boolean" },
        "defaultProductImageUrl": { "type": "string", "format": "uri" },
        "defaultProfileImageUrl": { "type": "string", "format": "uri" },
        "lowStockThreshold": { "type": "number" },
        "disablePriceModification": { "type": "boolean" },
        "enableWhatsapp": { "type": "boolean" },
        "whatsappSaleReceiptHeading": { "type": "string" },
        "whatsappCreditReceiptHeading": { "type": "string" },
        "whatsappGreeting": { "type": "string" },
        "whatsappReceiptFooter": { "type": "string" },
        "creditPaymentInstructions": { "type": "string" },
        "storeName": { "type": "string" },
        "paymentMethods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "iconUrl": { "type": "string", "format": "uri" }
            },
            "required": ["id", "name"]
          }
        },
        "socialMediaLinks": {
          "type": "array",
          "description": "A list of social media links for the footer.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "iconUrl": { "type": "string", "format": "uri" }
            },
            "required": ["id", "name", "url"]
          }
        },
        "storePhone": { "type": "string" },
        "storeEmail": { "type": "string", "format": "email" },
        "storeAddress": { "type": "string" },
        "footerDescription": {
          "type": "string",
          "description": "The descriptive text shown in the website footer under the logo."
        },
        "showFooterDescription": {
          "type": "boolean",
          "description": "Whether to show the description in the footer."
        },
        "enableExternalPrinter": { "type": "boolean" },
        "receiptFooterMessage": { "type": "string" },
        "storeLogoUrl": { "type": "string", "format": "uri" },
        "invoiceLogoUrl": { "type": "string", "format": "uri" },
        "storeLogoWidth": { "type": "number", "description": "The display width of the main site logo in pixels." },
        "footerLogoWidth": { "type": "number", "description": "The display width of the footer logo in pixels." },
        "storeNameFontSize": { "type": "number", "description": "The font size of the store name in the header in pixels." },
        "loginImageUrl": {
          "type": "string",
          "format": "uri",
          "description": "Background image for public login/signup pages."
        },
        "invoiceAccentColor": { "type": "string", "description": "The accent color used on A4 invoices." },
        "invoiceEnableTextWatermark": { "type": "boolean", "description": "Whether to show a text watermark on A4 invoices." },
        "invoiceWatermarkText": { "type": "string", "description": "The text for the watermark (e.g., PAID, DRAFT)." },
        "invoiceWatermarkColor": { "type": "string", "description": "The color of the watermark text (hex)." },
        "invoiceWatermarkOpacity": { "type": "number", "description": "The opacity of the watermark text (0-1)." },
        "invoiceWatermarkFontSize": { "type": "number", "description": "The font size of the watermark text in pixels." },
        "invoiceWatermarkRotation": { "type": "number", "description": "The rotation of the watermark text in degrees." },
        "allowStockDeduction": { "type": "boolean" },
        "enableLowStockAlerts": { "type": "boolean" },
        "lowStockAlertPhoneNumber": { "type": "string" },
        "lowStockAlertMessage": { "type": "string" },
        "outOfStockAlertMessage": { "type": "string" },
        "enableSms": { "type": "boolean" },
        "smsSenderId": { "type": "string" },
        "smsWebhookUrl": { "type": "string", "format": "uri" },
        "whatsappWebhookUrl": { "type": "string", "format": "uri" },
        "whatsappMarketingGreeting": { "type": "string" },
        "whatsappMarketingFooter": { "type": "string" },
        "imgbbApiKey": { "type": "string", "description": "API key for the ImgBB image hosting service." },
        "eBulkUsername": { "type": "string", "description": "Username for the eBulkSMS API." },
        "eBulkApiKey": { "type": "string", "description": "API key for the eBulkSMS API." },
        "brandValues": {
          "type": "array",
          "description": "Configuration for the brand values/features section on the public site.",
          "items": {
            "type": "object",
            "properties": {
              "icon": { "type": "string", "description": "Lucide icon name for the value." },
              "title": { "type": "string", "description": "Title of the value proposition." },
              "description": { "type": "string", "description": "Description of the value proposition." }
            },
            "required": ["icon", "title", "description"]
          }
        },
        "brandValuesBackgroundColor": { "type": "string", "description": "Background color for the brand values section." },
        "showBrandValues": { "type": "boolean", "description": "Whether to show the brand values section on the public site." },
        "showNewsletterSection": { "type": "boolean", "description": "Whether to show the newsletter section on the public site." },
        "newsletterSectionTitle": { "type": "string", "description": "Title for the newsletter section." },
        "newsletterSectionDescription": { "type": "string", "description": "Description for the newsletter section." },
        "newsletterSectionBackgroundColor": { "type": "string", "description": "Background color for the newsletter section." },
        "storeAddToCartText": { "type": "string" },
        "storeAddToCartIcon": { "type": "string" },
        "storeGridCartText": { "type": "string" },
        "storeGridCartIcon": { "type": "string" },
        "storeHeroBtnText": { "type": "string" },
        "storeHeroBtnIcon": { "type": "string" },
        "imageUploadQuality": { "type": "number" },
        "imageMaxWidth": { "type": "number" },
        "imageMaxFileSizeMb": { "type": "number" }
      }
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "Represents a staff member with roles and permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID from Firebase Auth." },
        "name": { "type": "string", "description": "The staff member's full name." },
        "email": { "type": "string", "format": "email", "description": "The staff member's email address, used for login." },
        "phone": { "type": "string", "description": "The staff member's phone number." },
        "role": { "type": "string", "description": "The role ID assigned to the staff member." },
        "status": { "type": "string", "enum": ["Active", "Inactive"], "description": "The status of the staff member's account." },
        "avatar": { "type": "string", "format": "uri", "description": "URL of the staff member's profile picture." },
        "totalSales": { "type": "number", "description": "Computed total sales value by this staff member." },
        "totalTransactions": { "type": "number", "description": "Computed total number of transactions by this staff member." },
        "todaySales": { "type": "number", "description": "Computed sales value for the current day." },
        "permissions": {
          "type": "object",
          "properties": {
            "pages": { "type": "array", "items": { "type": "string" }, "description": "List of page permission IDs." }
          }
        }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "SaleTransaction": {
      "title": "Sale Transaction",
      "description": "Records a sale made by a staff member.",
      "type": "object",
      "properties": {
        "staffId": { "type": "string", "description": "The UID of the staff member who made the sale." },
        "grandTotal": { "type": "number", "description": "The total amount of the sale." },
        "returnedAmount": { "type": "number", "description": "Any amount returned in the transaction." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp of the sale." },
        "discountValue": { "type": "number", "description": "The value of the discount (e.g., 10 for 10% or 10 for $10).", "nullable": true },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"], "description": "The type of discount applied.", "nullable": true },
        "discountAmountCalculated": { "type": "number", "description": "The actual calculated discount amount in currency.", "nullable": true }
      },
      "required": ["staffId", "grandTotal", "createdAt"]
    }
  }
}
